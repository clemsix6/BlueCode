set quiet

dotnet := home_directory() / ".dotnet/dotnet"
output := "bin/Release/net10.0/osx-arm64/publish"

# Builds the single-file compiler and lays the pod justfile next to it.
publish:
    {{dotnet}} publish Compiler.csproj -c Release -r osx-arm64 --self-contained -p:PublishSingleFile=true -nologo -v:q
    cp dist/justfile {{output}}/justfile
    echo "→ {{output}}"

# Removes the build outputs.
clean:
    rm -rf bin obj
