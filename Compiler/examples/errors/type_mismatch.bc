/// Every line in this file has a type error: the compiler must report each one.

struct Point:
    int x
    int y


def int mixed (int a, uint b):
    return a + b


def bool not_a_bool (int x):
    return x


def int wrong_call (int x):
    return mixed(x)


def uint bad_cast (bool b):
    return uint(b)


def int no_field (Point p):
    return p.z


def (int, int) count (int x):
    return x


def int falls_through (int x):
    if x > 0:
        return 1


def int unused_result (int x):
    mixed(x, uint(x))
    return x


def Point wrong_arity ():
    return Point(1)


def Point wrong_field (bool b):
    return Point(1, b)
