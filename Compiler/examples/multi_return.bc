/// A function may return several values, received with one declaration per value.

external def (uint, uint) divmod (uint a, uint b):
    return a / b, a % b


external def (int, int) min_max (int a, int b):
    if a < b:
        return a, b
    return b, a


external def (int, int) swap (int a, int b):
    return b, a


external def (bool, uint) checked_sub (uint a, uint b):
    if b > a:
        return false, 0
    return true, a - b


external def uint use_divmod (uint a, uint b):
    uint quotient, uint remainder = divmod(a, b)
    return quotient * 10 + remainder


external def int spread (int a, int b):
    int low, int high = min_max(a, b)
    int first, int second = swap(low, high)
    return first - second
