/// A queue of transfers, kept by the pod between calls: each link owns the next, the state
/// owns the head. "take" moves what a field owns out of it and leaves none in its place, the
/// only way to remove something from a structure: reading an own field would leave it dead.

struct Transfer:
    uint from
    uint to
    uint amount
    own Transfer? next


state own Transfer? head
state uint length


/// The old head becomes the tail of the new one: taken out of the state, moved into the field.
external def () enqueue (uint from, uint to, uint amount):
    head = new Transfer(from, to, amount, take head)
    length = length + 1


/// "take ... or:" binds the head as an own value, or leaves. The next link is taken back
/// into the state; the link itself is freed when the function returns.
external def (bool, uint, uint, uint) dequeue ():
    own Transfer first = take head or:
        return false, 0, 0, 0
    head = take first.next
    length = length - 1
    return true, first.from, first.to, first.amount


/// Drops every link: taking the head frees the whole chain when the value dies here.
external def () clear ():
    own Transfer? all = take head
    length = 0


external def uint pending ():
    return length
