/// A ref parameter is the caller's variable itself, not a copy: what the function writes to it
/// stays written. A ref is only taken on a variable or a field, and only lives in a parameter
/// or a ref variable, so it can never outlive what it names.

struct Point:
    int x
    int y


struct Line:
    Point start
    Point end


external def () swap (ref int a, ref int b):
    int tmp = a
    a = b
    b = tmp


def () translate (ref Point point, int dx, int dy):
    point.x = point.x + dx
    point.y = point.y + dy


/// A field of a ref is handed down to a callee like any other variable.
external def () shift (ref Line line, int dx, int dy):
    translate(ref line.start, dx, dy)
    translate(ref line.end, dx, dy)


/// A ref variable names a place for the rest of the block: assigning it writes there.
external def () clamp_start (ref Line line):
    ref Point p = ref line.start
    if p.x < 0:
        p.x = 0
    if p.y < 0:
        p.y = 0


/// Puts two points in order of x, in place, and returns their distance along x.
external def int order (ref Point a, ref Point b):
    if a.x > b.x:
        swap(ref a.x, ref b.x)
        swap(ref a.y, ref b.y)
    return b.x - a.x


/// The parameter is a copy: the caller's point is not moved.
external def int moved_x (Point point, int dx):
    translate(ref point, dx, 0)
    return point.x
