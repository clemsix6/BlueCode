/// A value marked "own" lives in memory of its own, for as long as the variable or field that
/// owns it: it is freed the moment its owner is reassigned, goes out of scope, or is handed
/// over and dropped. It moves rather than copies: giving it to a function or a field hands it
/// over, and the old name is dead. A ref into it is taken like into anything else, for the
/// length of a call, and nothing else ever points to it, so nothing can outlive it. A "?" on
/// an own says it may hold nothing, and the compiler makes sure that case is looked at.

struct Account:
    uint id
    uint balance


/// A tree of accounts by id. Each child is owned by its parent, or absent.
struct Node:
    uint key
    Account account
    own Node? left
    own Node? right


/// The pod's state: what it keeps from one call to the next, in its instance. The tree lives
/// here, owned by the state, freed with the instance.
state own Node? accounts
state uint count


/// "new" builds a value in its own memory, every field given in order. The caller owns it.
def own Node leaf (Account account):
    return new Node(account.id, account, none, none)


/// Works on the tree the caller owns. "if ref ... = ref ...:" binds the child when there is
/// one; the else branch is the only place where the field is known to be empty.
def () insert (ref Node tree, Account account):
    if account.id < tree.key:
        if ref Node child = ref tree.left:
            insert(ref child, account)
        else:
            tree.left = leaf(account)       // the field takes the new node over
    elif account.id > tree.key:
        if ref Node child = ref tree.right:
            insert(ref child, account)
        else:
            tree.right = leaf(account)
    else:
        tree.account = account


/// "or:" binds the child or leaves the function, like "catch err:" does for a failure.
def (bool, uint) find (ref Node tree, uint id):
    if id == tree.key:
        return true, tree.account.balance
    if id < tree.key:
        ref Node child = ref tree.left or:
            return false, 0
        return find(ref child, id)
    ref Node child = ref tree.right or:
        return false, 0
    return find(ref child, id)


def uint size (ref Node tree):
    uint total = 1
    if ref Node left = ref tree.left:
        total = total + size(ref left)
    if ref Node right = ref tree.right:
        total = total + size(ref right)
    return total


/// Only external functions are reachable from the host, and nothing that owns memory crosses:
/// the host passes and gets back plain values, the tree stays in the instance.
external def () register (Account account):
    if ref Node root = ref accounts:
        insert(ref root, account)
    else:
        accounts = leaf(account)
    count = count + 1


external def (bool, uint) balance (uint id):
    ref Node root = ref accounts or:
        return false, 0
    return find(ref root, id)


external def uint registered ():
    return count


external def uint nodes ():
    ref Node root = ref accounts or:
        return 0
    return size(ref root)


/// Replacing what a field owns frees it, subtree included: pruning is one assignment.
external def () prune_left ():
    if ref Node root = ref accounts:
        root.left = none


/// Handing the tree over to a function that lets it go frees it entirely.
def () discard (own Node tree):
    return


external def () clear ():
    if own Node tree = take accounts:
        discard(tree)
    count = 0
