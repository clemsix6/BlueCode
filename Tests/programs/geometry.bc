/// This is an example of a simple program written in the BlueCode language.
struct Point:
    int x
    int y


/// Represents a line segment defined by two points.
struct Line:
    Point start
    Point end


/// Returns the sum and difference of two integers.
external def (int, int) operate (int x, int y):
    int ret_1 = x + y
    int ret_2 = x - y
    return ret_1, ret_2 // here we return a tuple containing the sum and difference of x and y


/// Returns the product of two unsigned integers.
external def uint mul (uint x, uint y):
    return x * y


/// Returns the absolute value of an integer as an unsigned integer.
external def uint abs (int x):
    if x < 0:
        return uint(-x)  // here we convert the negative integer to its positive equivalent and then cast it to uint
    else:
        return uint(x)  // here we simply cast the positive integer to uint


/// A struct is built by calling its name with one value per field, in order.
external def Line segment (int x1, int y1, int x2, int y2):
    return Line(Point(x1, y1), Point(x2, y2))


/// Calculates the size of a line segment defined by two points.
external def uint size (Line line):
    int dx = line.end.x - line.start.x
    int dy = line.end.y - line.start.y
    return abs(dx) + abs(dy)


/// Complex calculation to test the AST.
external def int complex_calculation ():
    int a = 4 + 6 - 12 * 3 - 4
    int b = 2 * a
    int c = 3 * b - 4
    return c
