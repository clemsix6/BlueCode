/// An "own" value lives in a block of the instance's heap and has one owner at a time. Giving
/// it to a function, to a field or to another name hands it over and kills the old name;
/// whoever holds it when the block or the function ends frees it, subtree included. "take" is
/// the only way to move a value out of a place, and it leaves none behind. A "?" says the
/// place may hold nothing, which "if ref", "if own" and "or:" are the three ways to look at.

struct Point:
    int x
    int y


/// A struct with an own field owns it in turn, so the struct itself moves instead of copying.
struct Pair:
    own Point first
    own Point? second


/// Each link owns the next, so the chain is freed from its head in one assignment.
struct Link:
    int value
    own Link? next


/// The state is the only place an own outlives a call, so it is where the host can measure it.
state own Link? chain
state own Pair? pair


// New values and handing them over.

/// "new" cuts a block and yields an own; whoever receives it owns it.
def own Point point (int x, int y):
    return new Point(x, y)


/// A function may answer with an own or with nothing, which the caller then has to look at.
def own Point? point_unless (int x, int y, bool nothing):
    if nothing:
        return none
    return new Point(x, y)


/// A value parameter is handed over: this function frees what it is given.
def () discard (own Point p):
    return


/// Unless it hands it on in turn, and then frees nothing itself.
def () relay (own Point p):
    discard(p)


external def int handed_to_a_callee (int x, int y):
    own Point p = point(x, y)
    int sum = p.x + p.y
    discard(p)
    return sum


external def int handed_on_twice (int x, int y):
    own Point p = point(x, y)
    int sum = p.x + p.y
    relay(p)
    return sum


/// A value moved into another name dies under the old one; the new name frees it.
external def int moved_into_a_name (int x, int y):
    own Point p = point(x, y)
    own Point q = p
    return q.x + q.y


/// A branch that leaves the function may move the value: what follows the "if" still owns it.
external def int moved_in_a_returning_branch (int x, int y, bool early):
    own Point p = point(x, y)
    if early:
        discard(p)
        return 0
    int sum = p.x + p.y
    discard(p)
    return sum


// Where a value is freed.

/// A value declared inside the loop body is freed at the end of every round, so a heap of one
/// block carries any number of rounds.
external def int freed_every_round (int rounds):
    int i = 0
    int sum = 0
    while i < rounds:
        own Point p = new Point(i, 1)
        sum = sum + p.y
        i = i + 1
    return sum


/// A value the function still holds is freed on the way out.
external def int freed_at_the_exit (int x, int y):
    own Point p = point(x, y)
    return p.x + p.y


/// Assigning a place frees what it held, and "none" frees the whole chain at once.
external def () replace_chain (int value):
    chain = new Link(value, none)


external def () clear_chain ():
    chain = none


/// Pushing keeps the old head by taking it out of the state first: reading it would kill it.
external def () push (int value):
    chain = new Link(value, take chain)


/// Taking a value out and putting it straight back leaves the heap exactly as it was.
external def () round_trip ():
    own Link? taken = take chain
    chain = taken


// The two binding forms, and "or:".

/// "if ref" looks at what an own may hold without moving it.
external def (bool, int) head_value ():
    if ref Link first = ref chain:
        return true, first.value
    return false, 0


/// "if own" moves it out instead: the name owns it, and frees it at the end of the arm.
external def (bool, int) drop_head ():
    bool found = false
    int value = 0
    if own Link first = take chain:
        chain = take first.next
        value = first.value
        found = true
    return found, value


def int count (ref Link link):
    if ref Link next = ref link.next:
        return 1 + count(ref next)
    return 1


/// "or:" binds the same way but leaves the function when there is nothing to bind.
external def int chain_length ():
    ref Link first = ref chain or:
        return 0
    return count(ref first)


/// The optional an own function returns is bound the same way.
external def (bool, int) maybe_point (int x, int y, bool nothing):
    own Point? answer = point_unless(x, y, nothing)
    if ref Point p = ref answer:
        return true, p.x + p.y
    return false, 0


// A struct that owns.

/// Kept in a local, a movable struct frees the fields it owns when the function ends.
external def int pair_sum (int x, int y):
    Pair p = Pair(point(x, y), point_unless(x, y, false))
    if ref Point second = ref p.second:
        return p.first.x + second.y
    return p.first.x


/// Assigning a field frees what the field held.
external def int replace_first (int x, int y):
    Pair p = Pair(point(0, 0), none)
    p.first = point(x, y)
    return p.first.x + p.first.y


/// Moving the struct into a place hands over everything it owns.
external def () park_pair (int x, int y):
    pair = new Pair(point(x, y), point_unless(x, y, false))


external def () clear_pair ():
    pair = none


// A failure between the read and the move.

def () consume (own Point p, int n):
    return


/// The value is read as an argument, but the argument after it faults before the move is
/// committed: the local still holds it, so it is freed on the way out like any other.
external def () lost_on_a_fault (int n):
    own Point p = point(1, 2)
    consume(p, 10 / n)
