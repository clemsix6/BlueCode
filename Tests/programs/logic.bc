/// Booleans: comparisons, and, or, not.

external def bool is_between (int x, int low, int high):
    return x >= low and x <= high


external def bool is_outside (int x, int low, int high):
    return not is_between(x, low, high)


external def bool either (bool a, bool b):
    return a or b


external def bool xor (bool a, bool b):
    return (a or b) and not (a and b)


external def bool same_sign (int a, int b):
    return (a < 0) == (b < 0)


external def int sign (int x):
    if x < 0:
        return -1
    elif x == 0:
        return 0
    else:
        return 1


external def int max3 (int a, int b, int c):
    int m = a
    if b > m:
        m = b
    if c > m:
        m = c
    return m
