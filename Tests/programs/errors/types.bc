/// Types and operators. There is no implicit conversion of any kind: the two integer types do
/// not meet, a bool is not a number, and a value of one struct is not a value of another. The
/// only conversion is the explicit cast, and it joins the two integer types and nothing else.
/// One consequence has no workaround: a negative number is a minus applied to a literal, so
/// the smallest int is a literal one too large for int and cannot be written at all.
/// The last cases are about how a type may be spelled at all: owning and being optional are
/// two halves of one thing, and both are about structs.

struct Point:
    int x
    int y


error Something


def int literal_too_large_for_int ():
    return 9223372036854775808  // error: integer literal is too large for int


def uint literal_too_large_for_uint ():
    return 18446744073709551616  // error: integer literal is too large for uint


def int smallest_int_cannot_be_written ():
    return -9223372036854775808  // error: integer literal is too large for int


def bool not_on_a_number (int n):
    return not n  // error: 'not' needs a bool, got int


def int minus_on_a_bool (bool b):
    return -b  // error: unary '-' needs an int, got bool


def int minus_on_an_unsigned (uint n):
    return -n  // error: unary '-' needs an int, got uint


def uint negative_literal_is_signed ():
    uint n = -1  // error: cannot assign int to 'n' of type uint
    return n


def int mixed_operands (int a, uint b):
    return a + b  // error: operator '+' cannot mix int and uint


def bool chained_comparison (int a, int b, int c):
    return a < b < c  // error: operator '<' cannot mix bool and int


def bool and_on_numbers (int a, int b):
    return a and b  // error: operator 'and' needs bools, got int


def bool structs_compared (Point p, Point q):
    return p == q  // error: structs cannot be compared with '=='


def bool nothing_compared ():
    return none == none  // error: an own cannot be compared: bind it with 'if ref' to see whether it holds something


def bool bools_added (bool a, bool b):
    return a + b  // error: operator '+' needs numbers, got bool


def bool structs_ordered (Point p, Point q):
    return p < q  // error: operator '<' needs numbers, got Point


def ()! error_source (int value):
    if value < 0:
        return error.Something
    return


def bool error_ordered (int value):
    error_source(value) catch err:
        return err < error.Something  // error: an error can only be compared with '==' or '!='
    return true


def int cast_without_an_argument ():
    return int()  // error: a cast to int takes exactly one argument


def int cast_with_two_arguments ():
    return int(1, 2)  // error: a cast to int takes exactly one argument


def uint cast_to_uint_without_an_argument ():
    return uint()  // error: a cast to uint takes exactly one argument


def uint cast_from_a_bool (bool b):
    return uint(b)  // error: cannot cast bool to uint


def int cast_from_a_struct (Point p):
    return int(p)  // error: cannot cast Point to int


def bool cast_to_a_bool (int n):
    return bool(n)  // error: cannot cast int to bool


def int field_of_a_number (int n):
    return n.x  // error: int has no fields


def int unknown_field (Point p):
    return p.z  // error: struct 'Point' has no field 'z'


def uint int_does_not_become_uint (int n):
    uint u = n  // error: cannot assign int to 'u' of type uint
    return u


def int uint_does_not_become_int (uint n):
    int i = n  // error: cannot assign uint to 'i' of type int
    return i


def bool numbers_are_not_bools ():
    bool flag = 1  // error: cannot assign int to 'flag' of type bool
    return flag


def int assignment_mismatch (int n, uint u):
    int total = n
    total = u  // error: cannot assign uint to a target of type int
    return total


def int optional_without_an_own (Point? p):  // error: only an own can be optional: write 'own T?'
    return p.x


def int owned_number (own int n):  // error: only a struct can be owned, not int
    return 0


def int owned_bool (own bool b):  // error: only a struct can be owned, not bool
    return 0
