/// Every way memory ownership can be misused: the compiler must reject each one.

struct Point:
    int x
    int y


struct Node:
    int value
    own Node? next


struct Loop:
    Loop inner  // error: struct 'Loop' contains itself: own the field instead


struct Line:
    Point start
    Point end


def own Node leaf (int value):
    return new Node(value, none)


def () keep (own Node node):
    return


external def own Node crossing (int value):  // error: 'crossing' is external: it cannot take or return an own
    return leaf(value)


def () used_after_move (own Node node):
    keep(node)
    keep(node)  // error: 'node' was moved


def () moved_in_a_loop (own Node node, uint n):
    uint i = 0
    while i < n:
        keep(node)  // error: 'node' is moved inside a loop
        i = i + 1


def () moved_out_of_a_field (ref Node node):
    keep(node.next)  // error: cannot move out of a field: take a ref into it, or take it with 'take' // error: argument 1 should be own Node, got own Node?


def () moved_out_of_a_ref (ref Node node):
    keep(node)  // error: cannot move out of ref 'node' // error: argument 1 should be own Node, got Node


def () frozen (ref Line line):
    ref Point p = ref line.start
    line.start = Point(0, 0)  // error: cannot assign 'line.start' while 'p' refers into it


def () own_of_int ():
    own int n = new int(1)  // error: only a struct can be owned, not int // error: 'int' is not a struct


def () none_to_a_plain_own ():
    own Node node = none  // error: cannot assign none to 'node' of type own Node


def () optional_field_read (ref Node node):
    int v = node.next.value  // error: own Node? may be none: bind it with 'if ref' or 'or:' first


def () owns_compared (ref Node a, ref Node b):
    bool same = a.next == b.next  // error: an own cannot be compared: bind it with 'if ref' to see whether it holds something


def () take_on_a_plain_own (own Node node):
    own Node? taken = take node  // error: 'take' needs an optional own, got own Node


def int fresh_field_read ():
    return leaf(1).value  // error: a value that owns memory has to be kept in a variable before its fields are read


state own Node? root


def () state_moved ():
    keep(root)  // error: cannot move out of state 'root': take a ref into it, or take it with 'take' // error: argument 1 should be own Node, got own Node?


def () frozen_through_an_own (ref Node tree):
    ref Node child = ref tree.next or:
        return
    tree.next = none  // error: cannot assign 'tree.next' while 'child' refers into it


def () or_block_that_stays (ref Node tree):
    ref Node child = ref tree.next or:  // error: the 'or:' block must leave the function
        tree.value = 0
    tree.value = child.value


def () bound_from_a_plain_own (own Node node):
    if ref Node same = ref node:  // error: expected an own that may be none, got Node
        return


def () bound_to_the_wrong_type (ref Node tree):
    if ref Point child = ref tree.next:  // error: cannot bind Node to 'child' of type Point
        return


def () state_by_ref (ref Node tree):
    return
