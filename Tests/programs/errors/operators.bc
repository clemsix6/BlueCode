/// Operators and calls given values of the wrong type or the wrong count.

struct Point:
    int x
    int y


def (int, int) pair (int a):
    return a, a


def int one (int a):
    return a


def () nothing ():
    return


def bool not_on_int (int x):
    return not x  // error: 'not' needs a bool, got int


def uint negate_uint (uint x):
    return -x  // error: unary '-' needs an int, got uint


def bool and_on_int (int a, int b):
    return a and b  // error: operator 'and' needs bools, got int


def bool order_bools (bool a, bool b):
    return a < b  // error: operator '<' needs numbers, got bool


def bool compare_structs (Point a, Point b):
    return a == b  // error: structs cannot be compared with '=='


def int int_as_condition (int x):
    if x:  // error: condition must be bool, got int
        return 1
    return 0


def uint declared_wrong (int x):
    uint y = x  // error: cannot assign int to 'y' of type uint
    return y


def int assigned_wrong (int x, uint y):
    x = y  // error: cannot assign uint to a target of type int
    return x


def int too_few_names (int a):
    int b = pair(a)  // error: expected 1 value(s), got 2
    return b


def int call_in_expression (int a):
    return pair(a) + 1  // error: the call returns 2 values, only one can be used here


def int nothing_as_value ():
    return nothing()  // error: the call returns nothing


def (int, int) passes_on_wrong_count (int a):
    return one(a)  // error: 'passes_on_wrong_count' returns 2 value(s), the call gives 1


def (uint, int) passes_on_wrong_types (int a):
    return pair(a)  // error: value 1 of the call is int, uint is expected


def uint cast_two (int a):
    return uint(a, a)  // error: a cast to uint takes exactly one argument


def int call_a_field (Point p):
    return p.x(1)  // error: only a function or a type can be called


def int field_of_int (int x):
    return x.y  // error: int has no fields
