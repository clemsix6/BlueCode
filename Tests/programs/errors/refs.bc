/// Every way a ref can be misused: the compiler must reject each one.

struct Account:
    uint id
    uint balance


struct Wallet:
    ref Account owner  // error: a struct field cannot be a ref


def () bump (ref uint n):
    n = n + 1


def () deposit (ref Account account, uint amount):
    account.balance = account.balance + amount


def uint fresh_id ():
    return 7


def (uint, uint) pair (uint n):
    return n, n


def ref Account pick (Account account):  // error: a function cannot return a ref
    return account


def () missing_ref (Account account):
    deposit(account, 100)  // error: argument 1 must be passed with 'ref'


def () ref_on_a_value_parameter (Account account, uint amount):
    deposit(ref account, ref amount)  // error: argument 2 is not a ref parameter


def () ref_to_a_value ():
    bump(ref fresh_id())  // error: 'ref' needs a variable or a field, not a value


def () ref_variable_without_ref (uint n):
    ref uint m = n  // error: a ref variable must be bound with 'ref'


def () ref_variable_among_others (uint n):
    ref uint a, uint b = pair(n)  // error: a ref variable must be declared on its own


def () ref_in_an_expression (uint n):
    uint m = ref n  // error: 'ref' is only allowed on a call argument or in a ref declaration


def () ref_rebound (uint n, uint other):
    ref uint m = ref n
    m = ref other  // error: 'ref' is only allowed on a call argument or in a ref declaration


def uint ref_returned (uint n):
    return ref n  // error: 'ref' is only allowed on a call argument or in a ref declaration
