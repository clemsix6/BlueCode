/// while is the only loop.

external def uint factorial (uint n):
    uint result = 1
    while n > 1:
        result = result * n
        n = n - 1
    return result


external def uint fibonacci (uint n):
    uint a = 0
    uint b = 1
    while n > 0:
        uint next = a + b
        a = b
        b = next
        n = n - 1
    return a


external def uint gcd (uint a, uint b):
    while b != 0:
        uint remainder = a % b
        a = b
        b = remainder
    return a


external def uint power (uint base, uint exponent):
    uint result = 1
    while exponent > 0:
        if exponent % 2 == 1:
            result = result * base
        base = base * base
        exponent = exponent / 2
    return result


external def uint digit_sum (uint n):
    uint total = 0
    while n > 0:
        total = total + n % 10
        n = n / 10
    return total


external def uint collatz_steps (uint n):
    uint steps = 0
    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1
        steps = steps + 1
    return steps
