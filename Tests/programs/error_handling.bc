/// Errors are values. A function that can fail says so with "!" after its return type, and
/// returns either a value or an error: the type of what follows "return" decides which.
/// A caller relays a failure with "try", replaces it with "catch value", or examines it in a
/// "catch err:" block that has to leave the function. Nothing lets a failure be dropped.

struct Account:
    uint id
    uint balance
    bool frozen


struct Fees:
    uint flat
    uint per_thousand


/// Every error is a name declared at file level. The compiler numbers them, the manifest
/// gives the host the names back, and a trace of the functions a failure went through.
error Frozen
error Insufficient
error SameAccount
error PayrollUnfunded


def uint fee_for (Fees fees, uint amount):
    return fees.flat + amount / 1000 * fees.per_thousand


/// Fails with the reason, or returns the balance left.
external def uint! withdraw (ref Account account, uint amount, Fees fees):
    if account.frozen:
        return error.Frozen
    uint total = amount + fee_for(fees, amount)
    if account.balance < total:
        return error.Insufficient
    account.balance = account.balance - total
    return account.balance


/// A function may fail without having a value to return.
external def ()! deposit (ref Account account, uint amount):
    if account.frozen:
        return error.Frozen
    account.balance = account.balance + amount


/// "try" hands a failure up to the caller, with this line added to its trace, and is only
/// allowed in a function marked "!". Everything that can be refused is checked before
/// anything is written, so a refused transfer leaves both accounts as they were.
external def uint! transfer (ref Account from, ref Account to, uint amount, Fees fees):
    if from.id == to.id:
        return error.SameAccount
    if to.frozen:
        return error.Frozen
    uint left = try withdraw(ref from, amount, fees)
    try deposit(ref to, amount)
    return left


/// "catch value" settles a failure on the spot: the value stands in and the function goes on.
/// This function can not fail, so it needs no "!".
external def uint left_after (Account account, uint amount, Fees fees):
    uint left = withdraw(ref account, amount, fees) catch 0
    return left


/// "catch err:" looks at the failure. The block has to leave the function, so the lines after
/// it only run when the call succeeded and "left" is always a real balance. Returning "err"
/// relays the original failure, returning another error replaces it, and the trace tells
/// which of the two happened.
external def uint! pay_salary (ref Account employer, ref Account employee, uint salary, Fees fees):
    uint left = transfer(ref employer, ref employee, salary, fees) catch err:
        if err == error.Insufficient:
            return error.PayrollUnfunded
        return err
    return left


/// A function without "!" can still call one that fails: it just has to settle every failure
/// itself, here by turning it into a bool.
external def bool credit (ref Account account, uint amount):
    deposit(ref account, amount) catch err:
        return false
    return true
