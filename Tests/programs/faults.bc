/// What a pod does when it gives up. The gas the host gets back is the code of the fault,
/// the results come back all zero, and whatever a ref argument already held stays written.
/// A fault is not an error: it travels as a negative gas, so neither catch nor try ever sees
/// one, and every caller it passes through keeps the frames of the callee under its own.
/// Nesting is bounded: the call that arrives one step past the limit is the one that gives up,
/// and its frame names the line its function is declared on.

error Refused


struct Counter:
    uint hits


// A chain of three, so that a fault raised at the bottom carries one frame per caller.
external def int deep_divide (int a, int b):
    return middle(a, b)


def int middle (int a, int b):
    return bottom(a, b)


def int bottom (int a, int b):
    return a / b


// A ref written before the fault: the host keeps what it was given, the results are zeroed.
external def (int, int) count_then_divide (ref Counter counter, int a, int b):
    counter.hits = counter.hits + 1
    return a / b, a


// One call per step, so the host can drive the chain to exactly the depth it wants.
external def uint nest (uint n):
    if n == 0:
        return 0
    return nest(n - 1) + 1


// The error this one declares is settled by its caller; the division is not its to settle.
def int! refuse_or_divide (int a, int b, bool refuse):
    if refuse:
        return error.Refused
    return a / b


external def int settled (int a, int b, bool refuse):
    int result = refuse_or_divide(a, b, refuse) catch 0
    return result


external def int! relayed (int a, int b, bool refuse):
    return try refuse_or_divide(a, b, refuse)
